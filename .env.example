# 复制为各自的运行环境变量；不要提交真实值
# 本机 Node fetch 需走本地代理（按需）
NODE_USE_ENV_PROXY=1
# 监控：实盘=1，模拟=不设或 0
FOUR_ARM=0
# 每次自动买入预算（BNB）
FOUR_BUDGET_BNB=0.01
# 盯的模板 presetId（Four.meme Binance Agent ID Exclusive）
FOUR_PRESET=1778027615735
# 可选：自带 getLogs 高吞吐端点（逗号分隔），留空用 publicnode 免费节点
# FOUR_LOGS_RPC=https://bsc.publicnode.com,https://your-keyed-endpoint
# GMGN API key 放 ~/.config/gmgn/.env 的 GMGN_API_KEY=...（面板自动读取）
